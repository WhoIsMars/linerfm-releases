---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---
<BaseLayout title="LinerFM — Privacy Policy" description="LinerFM runs entirely on your Mac. No account, no telemetry, no server.">
  <Nav />
  <main class="max-w-3xl mx-auto px-5 py-16">
    <h1 class="text-3xl font-bold">Privacy Policy</h1>
    <p class="mt-4 text-white/70">LinerFM runs entirely on your Mac. It has no backend server, no analytics, and no account system.</p>
    <ul class="mt-6 space-y-3 text-white/70 text-sm list-disc pl-5">
      <li>Your Spotify and Groq API keys are stored locally on your device and used only to call those services directly from your Mac.</li>
      <li>Your listening history and playlist data never leave your machine.</li>
      <li>We collect no telemetry, no usage data, and set no cookies on this website.</li>
      <li>Payments are processed by Lemon Squeezy (our Merchant of Record); their privacy policy governs the checkout.</li>
    </ul>
    <p class="mt-8 text-xs text-white/40">Last updated: 2026-06-13. Questions: open an issue on GitHub.</p>
  </main>
  <Footer />
</BaseLayout>
