---
// La home (24/10/2026, sul modello di aestheticmac.com/ibaila, richiesta dell'owner). Seconda passata:
// sezioni a ritmo regolare invece dello scatto a schermo intero, scorrimento morbido (Lenis), titoli
// parola per parola, ogni media nella cornice con la luce ai bordi. Le sezioni delle feature vengono da
// src/data/home.ts; il movimento sta in src/scripts/motion.ts.
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import WorksWith from "../components/WorksWith.astro";
import FeatureScreen from "../components/FeatureScreen.astro";
import Pricing from "../components/Pricing.astro";
import Faq from "../components/Faq.astro";
import Download from "../components/Download.astro";
import Footer from "../components/Footer.astro";
import { FEATURE_SCREENS, ALSO, listJoin } from "../data/home";

const shown = FEATURE_SCREENS.filter((s) => s.media);
// Le riprese verticali si alternano a destra e a sinistra fra loro; le catture larghe stanno sotto il testo.
const phones = shown.filter((s) => s.media?.kind !== "screen").map((s) => s.id);
---
<BaseLayout>
  <div id="torch" aria-hidden="true"></div>
  <Nav />
  <main id="main-content">
    <Hero />
    <WorksWith />
    {shown.map((screen, i) => (
      <FeatureScreen screen={screen} flip={phones.indexOf(screen.id) % 2 === 1}>
        {i === shown.length - 1 && (
          <p class="mt-8 text-sm text-fg-3 leading-relaxed max-w-[44ch]" data-reveal style="--i:7">
            <span class="text-fg-2 font-medium">And also:</span> {listJoin(ALSO)}.
          </p>
        )}
      </FeatureScreen>
    ))}
    <Pricing />
    <Faq />
    <Download />
  </main>
  <Footer />
</BaseLayout>

<script>
  import "../scripts/motion";
</script>
