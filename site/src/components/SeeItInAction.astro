---
// Tour completo (demo 33s): AI playlist, screensaver, widget con canvas e lyrics.
// Qui i controlli nativi ci sono già, quindi la pausa richiesta da WCAG 2.2.2 è
// coperta: mancavano solo le dimensioni native, senza cui il layout salta.
import { mediaSize } from "../lib/media-dimensions";

const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, "/");
const demo = mediaSize("video/demo.mp4");
---
<section id="demo" class="max-w-6xl mx-auto px-5 py-20">
  <h2 class="text-3xl font-semibold tracking-[-0.02em] text-center">See it in action</h2>
  <p class="mt-3 text-center text-fg-3">
    A 30-second tour: AI playlists from what you play, the full-screen screensaver,
    and the widget with live canvas and lyrics.
  </p>

  <div class="mt-10 panel p-3 md:p-4">
    <div class="relative">
      <video
        src={`${base}video/demo.mp4`}
        poster={`${base}screenshots/screensaver.png`}
        width={demo?.width}
        height={demo?.height}
        autoplay
        muted
        loop
        playsinline
        controls
        preload="metadata"
        aria-label="LinerFM full demo: create AI playlists, launch the music screensaver, and use the now-playing widget with animated canvas and synced lyrics"
        class="relative block w-full h-auto rounded-[10px]"
      ></video>
    </div>
  </div>
</section>
