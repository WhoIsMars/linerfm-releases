---
import { CHECKOUT_URL } from "../config/links";
const perks = [
  "One-time purchase, no subscription",
  "Minor updates included forever",
  "Use on 2 Macs",
  "Widget & menu bar free forever",
];
---
<section id="pricing" class="max-w-3xl mx-auto px-5 py-20">
  <h2 class="text-3xl font-bold tracking-tight text-center">Simple pricing</h2>
  <div class="mt-10 rounded-3xl border border-green-500/40 bg-green-500/[.06] p-8 md:p-10">
    <div class="flex items-baseline gap-2">
      <span class="text-5xl font-bold">10€</span>
      <span class="text-white/50">one-time</span>
    </div>
    <ul class="mt-6 space-y-3">
      {perks.map((p) => (
        <li class="flex items-start gap-3 text-sm text-white/80">
          <span class="mt-1 text-green-500">✓</span><span>{p}</span>
        </li>
      ))}
    </ul>
    <a href={CHECKOUT_URL} class="lemonsqueezy-button btn-primary mt-8 block text-center font-semibold px-6 py-3.5 rounded-xl">Buy LinerFM · 10€</a>
    <p class="mt-3 text-center text-xs text-white/50">5-day free trial, no card needed — just download below.</p>
  </div>
</section>
