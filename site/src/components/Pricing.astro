---
import { CHECKOUT_URL, DISCORD_URL } from "../config/links";
// "No account. Pay once." (24/10/2026, owner: iBaila lo dice e noi no). A sinistra le due promesse
// in grande, a destra la scheda del prezzo con le quattro righe di sempre, la prova per prima.
// Ogni riga e' gia' detta altrove sul sito e verificata: card `local` di features.json (no account,
// niente sugli ascolti esce dal computer; "no telemetry" tolto con la 1.2.8, che manda i dati d'uso), FAQ "free" (nessun livello gratuito dopo la prova), EULA (un computer alla volta).
// Le due righe sotto il pulsante sono fg-2: sulla luce della copertina fg-3 scendeva a ~4,5:1.
// Lemon Squeezy e' il Merchant of Record (privacy.astro), quindi le tasse le gestisce lui.
const perks = [
  "5 days free with your Discord account, no card. Every feature from the first day.",
  "10€ once, no subscription. Minor updates included forever.",
  "One computer at a time, Mac or Windows. Move your license anytime.",
  "Runs on your computer: no account, and what you listen to stays there.",
];
const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, "/");
---
<section id="pricing" class="section" aria-labelledby="pricing-title">
  <div class="max-w-[1240px] w-full mx-auto px-5 sm:px-6 grid lg:grid-cols-2 gap-14 lg:gap-20 items-center">
    <div class="text-center lg:text-left">
      <p class="eyebrow" data-reveal>Pricing</p>
      <h2 id="pricing-title" class="t-section mt-5 mx-auto lg:mx-0 max-w-[11ch]" data-words>No account. <span class="text-halo">Pay once.</span></h2>
      <p class="t-lead mt-6 mx-auto lg:mx-0 max-w-[38ch]" data-reveal style="--i:1">
        No LinerFM account, no subscription, nothing you listen to sent to a server. You pay 10€ once and LinerFM is yours, on Mac or Windows.
      </p>
      <p class="mt-6 text-sm text-fg-3 max-w-[40ch] mx-auto lg:mx-0" data-reveal style="--i:2">
        Made by one person. Questions go to <a href={DISCORD_URL} data-discord="pricing" class="underline underline-offset-4 hover:text-fg">Discord</a>, and I answer them.
      </p>
    </div>

    {/* Il bordo che gira e l'alone dietro (price-card di iBaila): i colori delle copertine della
        pagina, perche' ogni canzone porta il suo. Il verde resta sul pulsante. */}
    <div class="price-card w-full max-w-md mx-auto" data-reveal="media" data-edge-light>
      <span class="price-card__glow" aria-hidden="true"></span>
      <span class="price-card__spin" aria-hidden="true"></span>
      <div class="price-card__inner p-8 md:p-10">
      <div class="flex items-center gap-3">
        <img src={`${base}icon-512.png`} alt="" width="44" height="44" class="w-11 h-11" loading="lazy" />
        <div>
          <p class="font-semibold">LinerFM</p>
          <p class="text-xs text-fg-3">for Mac and Windows</p>
        </div>
      </div>
      <div class="mt-7 flex items-baseline gap-2">
        <span class="text-7xl font-extrabold tracking-[-0.05em] tabular-nums">10€</span>
        <span class="text-fg-3 leading-tight">once.<br />No subscription.</span>
      </div>
      <ul class="mt-7 space-y-3">
        {perks.map((p) => (
          <li class="flex items-start gap-3 text-sm text-fg-2">
            <svg viewBox="0 0 16 16" width="16" height="16" class="mt-0.5 flex-none text-fg-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" /></svg>
            <span>{p}</span>
          </li>
        ))}
      </ul>
      <a href={CHECKOUT_URL} class="lemonsqueezy-button btn-primary mt-8 block text-center font-semibold px-6 py-3.5 rounded-full">Buy LinerFM · 10€</a>
      <p class="mt-4 text-center text-xs text-fg-2">Secure checkout by Lemon Squeezy, taxes handled for you.</p>
      <p class="mt-1 text-center text-xs text-fg-2">After the trial a license is required: there is no limited free tier.</p>
      </div>
    </div>
  </div>
</section>
