---
// Le superfici ambient (notch bar, search, screensaver, lyrics, volume HUD).
// Contenuto da src/data/features.json, generato da docs/product-surface.json nel
// repo dell'app: qui resta solo il layout. Screenshot e video sono girati dalle
// superfici reali con dati di scena (traccia fittizia).
import data from "../data/features.json";
import AmbientVideo from "./AmbientVideo.astro";
import { mediaSize } from "../lib/media-dimensions";

const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, "/");
const surfaces = data.surfaces;
---
<section id="surfaces" class="max-w-6xl mx-auto px-5 py-20">
  <h2 class="text-3xl font-semibold tracking-[-0.02em] text-center">Your music, on every surface</h2>
  <p class="mt-3 text-center text-fg-3">Beyond the widget: around the notch, in a quick search, under the lyrics, on your idle screen.</p>

  {/* Le card della stessa riga si pareggiano di nuovo: ora che la vetrina
      assorbe lo spazio che avanza, stirare non lascia più vuoti. */}
  <div class="mt-12 grid md:grid-cols-2 gap-6">
    {surfaces.map((s) => (
      <div class:list={["panel-quiet p-6 flex flex-col", s.wide && "md:col-span-2"]}>
        {s.wide ? (
          <div class="flex items-baseline justify-between flex-wrap gap-2">
            <h3 class="text-lg font-semibold">{s.title}</h3>
            <p class="text-sm text-fg-3">{s.blurb}</p>
          </div>
        ) : (
          <>
            <h3 class="text-lg font-semibold">{s.title}</h3>
            <p class="mt-1 text-sm text-fg-3">{s.blurb}</p>
          </>
        )}

        {/* Il media non viene mai ingrandito oltre la sua risoluzione nativa,
            perché sopra quella si sfoca: quando resta più stretto della card lo
            tiene la vetrina, che riempie la larghezza al posto suo. */}
        <div class="mt-5 media-frame">
          {s.media.kind === "video" ? (
            <AmbientVideo
              src={s.media.src}
              description={s.alt}
              maxWidth={s.media.maxWidth}
              class="w-full"
              videoClass="rounded-[10px]"
            />
          ) : (
            <img
              src={`${base}${s.media.src}`}
              alt={s.alt}
              width={mediaSize(s.media.src)?.width}
              height={mediaSize(s.media.src)?.height}
              style={s.media.maxWidth ? `max-width:${s.media.maxWidth}` : undefined}
              class="block w-full h-auto rounded-[10px]"
              loading="lazy"
            />
          )}
        </div>
      </div>
    ))}
  </div>
</section>
