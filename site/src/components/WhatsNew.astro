---
// Le novità della 1.0.0 subito sotto la presentazione, da vedere e non da
// leggere: il desktop dal vivo e LinerFM su Windows, ciascuno con una ripresa
// vera dell'app (Mac filmato col telefono, Windows registrato a schermo), poi le
// altre quattro novità in card.
//
// Ogni frase viene dalle card di docs/product-surface.json nel repo dell'app
// (le stesse di features.json): qui non si scrive copy nuovo. Le card mostrate
// qui sono escluse dalla griglia di Features, così non compaiono due volte.
import AmbientVideo from "./AmbientVideo.astro";
import data from "../data/features.json";
import { WHATS_NEW_IDS } from "../data/whats-new";

const card = (id: string) => {
  const c = data.cards.find((f) => f.id === id);
  if (!c) throw new Error(`features.json non ha la card "${id}"`);
  return c;
};
const live = card("live-desktop");
const win = card("windows");
// L'ultima frase della card Windows dice cosa resta solo Mac: va in una riga a
// parte, discreta, invece che in mezzo al testo.
const MAC_ONLY = "The notch, the screensaver and the live desktop stay Mac only for now.";
const winBody = win.d.replace(MAC_ONLY, "").trim();
const winMacOnly = win.d.includes(MAC_ONLY) ? MAC_ONLY : undefined;

const more = WHATS_NEW_IDS.slice(2).map(card);
---
<section id="new" class="max-w-6xl mx-auto px-5 pt-24 md:pt-28" aria-labelledby="new-title">
  <p class="w-fit mx-auto flex items-center gap-1.5 text-[11px] uppercase tracking-wider font-semibold text-mint-300 border border-hairline bg-panel-2 rounded-full px-2.5 py-1">
    <span class="status-dot"></span>New in {live.since}
  </p>
  <h2 id="new-title" class="mt-5 text-3xl md:text-[2.8rem] font-semibold leading-[1.06] tracking-[-0.028em] text-center text-balance">
    {live.t}
  </h2>
  <p class="mt-5 mx-auto max-w-2xl text-center text-fg-2 md:text-lg leading-relaxed text-pretty">{live.d}</p>
  <p class="mt-4 w-fit mx-auto text-xs text-fg-3 px-2.5 py-1 rounded-full border border-hairline bg-panel">Mac only for now</p>

  {/* La ripresa del desktop dal vivo sul MacBook sta nell'hero: qui la seconda, su due schermi. */}
  <div class="mt-12 md:mt-14 max-w-2xl mx-auto">
    <div class="panel p-2">
      <AmbientVideo
        src="video/clip-live-canvas.mp4"
        webm="video/clip-live-canvas.webm"
        poster="video/clip-live-canvas.jpg"
        lazy
        description="Two displays playing Good Morning by Kanye West: the animated Spotify Canvas runs as the wallpaper on the external monitor, with the Cover Flow and the player on both screens."
        videoClass="rounded-[10px] bg-ink-900"
      />
    </div>
  </div>

  <article id="windows" class="mt-24 md:mt-32 grid md:grid-cols-12 gap-8 md:gap-12 items-center scroll-mt-20">
    <div class="md:col-span-6 lg:col-span-6">
      <p class="w-fit flex items-center gap-1.5 text-[11px] uppercase tracking-wider font-semibold text-mint-300 border border-hairline bg-panel-2 rounded-full px-2.5 py-1">
        <span class="status-dot"></span>New in {win.since}
      </p>
      <h2 class="mt-4 text-3xl md:text-[2.4rem] font-semibold leading-[1.08] tracking-[-0.025em] text-balance">{win.t}</h2>
      <p class="mt-4 text-fg-2 leading-relaxed text-pretty">{winBody}</p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a href="#download" class="btn-primary font-semibold px-5 py-2.5 rounded-control">Try free for 5 days</a>
      </div>
      {winMacOnly && <p class="mt-5 text-xs text-fg-3 leading-relaxed">{winMacOnly}</p>}
    </div>
    <div class="md:col-span-6 lg:col-span-5 lg:col-start-8">
      <div class="panel p-2">
        <AmbientVideo
          src="video/clip-windows.mp4"
          webm="video/clip-windows.webm"
          poster="video/clip-windows.jpg"
          lazy
          description="LinerFM on Windows 11, with the taskbar at the bottom: the widget follows Taylor Swift and then Gigi Perez, the lyrics run across the top of the screen, and from its menu the widget changes look: a cover card, a full poster, the terminal theme and a slim bar."
          videoClass="rounded-[10px] bg-ink-900"
        />
      </div>
    </div>
  </article>

  <h3 class="mt-24 md:mt-28 text-xl font-semibold tracking-[-0.015em] text-center">Also new in {live.since}</h3>
  <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {more.map((f) => (
      <div class="panel-quiet p-5">
        <h4 class="font-semibold">{f.t}</h4>
        <p class="mt-1.5 text-sm text-fg-3 leading-relaxed">{f.d}</p>
      </div>
    ))}
  </div>
</section>
