---
// La cornice accesa (24/10/2026, seconda passata sul modello di iBaila): ogni media del sito sta
// dentro uno schermo con la luce ai bordi, che e' la feature del prodotto. Tre strati:
//  - .lf__halo: l'alone dietro, i due colori sfocati a 64 px, che respira piano (8 s);
//  - .lf__bezel: il vetro scuro dello schermo, raggi e ombra come la cornice del laptop di iBaila;
//  - .lf__inner: la luce dentro lo schermo, una fascia sfocata sul bordo interno, come la feature;
//  - .lf__rim: l'anello di luce sul bordo, un conic-gradient nei due colori che gira (10 s),
//    con una copia sfocata (.lf__bloom) per il bagliore.
// I colori arrivano da `glow` (src/data/home.ts), presi dalla ripresa: mai il verde.
// La luce si accende quando la cornice entra nello schermo (.is-in, motion.ts): con "Riduci
// movimento" e' accesa da subito e ferma.
interface Props {
  glow?: [string, string];
  /** "phone": ripresa verticale; "screen": cattura orizzontale della UI. */
  kind?: "phone" | "screen";
  class?: string;
  /** Rapporto del media, per riservare lo spazio (es. "1280 / 800"). */
  ratio?: string;
}
const { glow = ["#9cc8ff", "#c8b4ff"], kind = "screen", class: cls = "", ratio } = Astro.props;
const style = `--c1:${glow[0]};--c2:${glow[1]}${ratio ? `;--ratio:${ratio}` : ""}`;
---
<div class:list={["lf", `lf--${kind}`, cls]} style={style} data-edge-light data-reveal="media">
  <div class="lf__halo" aria-hidden="true"></div>
  <div class="lf__bezel">
    <div class="lf__screen"><slot /><div class="lf__inner" aria-hidden="true"></div></div>
    <div class="lf__rim" aria-hidden="true"></div>
    <div class="lf__bloom" aria-hidden="true"></div>
  </div>
</div>
