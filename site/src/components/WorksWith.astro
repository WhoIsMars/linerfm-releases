---
// Con cosa funziona. Seconda passata (24/10/2026, sul modello di iBaila): una card per sorgente col
// logo vero del marchio (SVG inline da `simple-icons`, versione fissata in package.json, via src/lib/brand-icons.ts), nel colore
// del marchio, con il suo alone in alto a sinistra che si accende al passaggio del mouse; sotto, Mac
// e Windows nella stessa riga. simple-icons non ha piu' il logo di Windows (rimosso su richiesta di
// Microsoft): al suo posto quattro riquadri disegnati qui, come fa iBaila.
// Le frasi vengono da FAQ e card di features.json: Apple Music e' seguita su Mac; YouTube Music e
// SoundCloud suonano in Chrome. Sotto, la prova gratuita detta una seconda volta.
import { BRAND } from "../lib/brand-icons";

const sources = [
  { name: "Spotify", where: "The app", icon: BRAND.spotify },
  { name: "Apple Music", where: "The Music app, on a Mac", icon: BRAND.applemusic },
  { name: "YouTube Music", where: "In Chrome", icon: BRAND.youtubemusic },
  { name: "SoundCloud", where: "In Chrome", icon: BRAND.soundcloud },
];
const WINDOWS = "M3 5.2 10.4 4.2v7.1H3V5.2Zm8.3-1.1L21 2.8v8.5h-9.7V4.1ZM3 12.7h7.4v7.1L3 18.8v-6.1Zm8.3 0H21v8.5l-9.7-1.3v-7.2Z";
const systems = [
  { name: "Mac", where: "macOS 11 or later, Apple Silicon and Intel", path: BRAND.apple.path },
  { name: "Windows", where: "Windows 10 and 11, 64-bit", path: WINDOWS },
];
---
<section id="works-with" class="section" aria-labelledby="works-title">
  <div class="max-w-[1240px] w-full mx-auto px-5 sm:px-6">
    <p class="eyebrow" data-reveal>Works with</p>
    <h2 id="works-title" class="t-section mt-5 max-w-[16ch]" data-words>Works with the app <span class="text-halo">you already use.</span></h2>
    <p class="t-lead mt-6 max-w-[46ch]" data-reveal style="--i:1">Pick your source once and the whole app follows it.</p>

    <ul class="mt-14 grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
      {sources.map((s, i) => (
        <li class="brand-card" style={`--brand:#${s.icon.hex};--i:${i}`} data-reveal>
          <span class="brand-card__glow" aria-hidden="true"></span>
          <span class="brand-card__logo">
            <svg viewBox="0 0 24 24" width="28" height="28" role="img" aria-label={`${s.name} logo`} fill="currentColor"><path d={s.icon.path} /></svg>
          </span>
          <h3 class="mt-6 text-lg sm:text-xl font-semibold tracking-[-0.02em]">{s.name}</h3>
          <p class="mt-1.5 text-[0.8125rem] text-fg-3">{s.where}</p>
        </li>
      ))}
    </ul>
    <ul class="mt-3 sm:mt-4 grid sm:grid-cols-2 gap-3 sm:gap-4">
      {systems.map((o, i) => (
        <li class="brand-card brand-card--row" style={`--brand:#e8eaf0;--i:${i + 4}`} data-reveal>
          <span class="brand-card__logo">
            <svg viewBox="0 0 24 24" width="26" height="26" role="img" aria-label={`${o.name} logo`} fill="currentColor"><path d={o.path} /></svg>
          </span>
          <div>
            <h3 class="text-lg sm:text-xl font-semibold tracking-[-0.02em]">{o.name}</h3>
            <p class="mt-1 text-[0.8125rem] text-fg-3">{o.where}</p>
          </div>
        </li>
      ))}
    </ul>

    <p class="mt-10 text-fg-2" data-reveal>
      Try it with yours: <span class="text-fg font-medium">5 days free with Discord, no card.</span>
      <a href="#download" class="ml-1 underline underline-offset-4 hover:text-fg">Get the download</a>
    </p>
  </div>
</section>
