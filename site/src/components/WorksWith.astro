---
// Con cosa funziona (24/10/2026): le quattro sorgenti e i due sistemi in una riga di nomi, scritti
// grandi. Niente loghi dei marchi: i nomi come testo e un'icona neutra che dice dove suona
// (un'app, il browser) o su cosa gira (portatile, fisso). Le frasi vengono da FAQ e card di
// features.json: Apple Music e' seguita su Mac; YouTube Music e SoundCloud suonano in Chrome.
// Sotto, la prova gratuita detta una seconda volta, vicino alle sorgenti (analisi del 24/10, §3.3).
const ICON = {
  app: "M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5v-13ZM4 8.5h16M7 6.25h.01M9.5 6.25h.01",
  browser: "M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM4 12h16M12 4c2.2 2.2 3.2 5 3.2 8s-1 5.8-3.2 8M12 4C9.8 6.2 8.8 9 8.8 12s1 5.8 3.2 8",
  laptop: "M5.5 6.5A1.5 1.5 0 0 1 7 5h10a1.5 1.5 0 0 1 1.5 1.5V15h-13V6.5ZM3 15h18l-1 3H4l-1-3Z",
  desktop: "M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5V15a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 15V5.5ZM9 20h6M12 16.5V20",
} as const;
const sources = [
  { name: "Spotify", where: "The app", icon: ICON.app },
  { name: "Apple Music", where: "The Music app, on a Mac", icon: ICON.app },
  { name: "YouTube Music", where: "In Chrome", icon: ICON.browser },
  { name: "SoundCloud", where: "In Chrome", icon: ICON.browser },
];
const systems = [
  { name: "Mac", where: "macOS 11 or later, Apple Silicon and Intel", icon: ICON.laptop },
  { name: "Windows", where: "Windows 10 and 11, 64-bit", icon: ICON.desktop },
];
---
<section id="works-with" class="screen" aria-labelledby="works-title">
  <div class="max-w-6xl w-full mx-auto px-4 sm:px-6">
    <h2 id="works-title" class="t-screen max-w-[18ch]" data-reveal style="--i:0">Works with the app you already use.</h2>
    <p class="t-lead mt-5 max-w-[46ch]" data-reveal style="--i:1">Pick your source once and the whole app follows it.</p>

    <ul class="mt-12 grid grid-cols-2 lg:grid-cols-4 border-t border-hairline" data-reveal style="--i:2">
      {sources.map((s) => (
        <li class="border-b border-hairline lg:border-b-0 lg:[&:not(:last-child)]:border-r py-5 md:py-6 pr-3 sm:pr-6 lg:pl-6 lg:first:pl-0">
          <h3 class="text-xl sm:text-2xl md:text-[1.75rem] font-semibold tracking-[-0.025em]">{s.name}</h3>
          <p class="mt-2 flex items-start gap-2 text-sm text-fg-3">
            <svg viewBox="0 0 24 24" width="18" height="18" class="flex-none mt-px" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={s.icon} /></svg>
            {s.where}
          </p>
        </li>
      ))}
    </ul>
    <ul class="grid grid-cols-2 border-b lg:border-t border-hairline" data-reveal style="--i:3">
      {systems.map((o) => (
        <li class="py-5 md:py-6 pr-3 sm:pr-6 lg:[&:not(:last-child)]:border-r border-hairline lg:[&:last-child]:pl-6">
          <h3 class="text-xl sm:text-2xl md:text-[1.75rem] font-semibold tracking-[-0.025em]">{o.name}</h3>
          <p class="mt-2 flex items-start gap-2 text-sm text-fg-3">
            <svg viewBox="0 0 24 24" width="18" height="18" class="flex-none mt-px" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={o.icon} /></svg>
            {o.where}
          </p>
        </li>
      ))}
    </ul>

    <p class="mt-10 text-fg-2" data-reveal style="--i:4">
      Try it with yours: <span class="text-fg font-medium">5 days free, no card.</span>
      <a href="#download" class="ml-1 underline underline-offset-4 hover:text-fg">Get the download</a>
    </p>
  </div>
</section>
