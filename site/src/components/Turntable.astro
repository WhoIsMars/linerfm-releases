---
// Il disco che accompagna la parte centrale della pagina.
//
// Sta al centro della finestra e non si sposta mai: quello che cambia è quanto
// è grande e quanto si vede. All'inizio riempie la scena, gira, ed è l'unica
// cosa in pagina; scendendo si rimpicciolisce e sfuma fino a diventare la
// texture di fondo su cui scorre il contenuto, continuando a girare.
//
// Il centraggio è tutto in CSS, così lo script tocca una proprietà sola e non
// rimisura posizioni a ogni fotogramma: era da lì che veniva il movimento a
// scatti della prima versione, e la sparizione verso destra.
//
// Tre cose deliberate:
//  - il disco è decorazione e sta fuori dall'albero accessibile;
//  - il contenuto non entra nell'animazione, resta il documento di prima, e
//    l'attenuazione delle voci la accende lo script, così senza JavaScript la
//    pagina è leggibile per intero;
//  - chi ha chiesto meno movimento al sistema trova il disco già sul fondo,
//    fermo, e l'apertura ridotta a una riga.
---
<div class="turntable" data-turntable>
  <div class="turntable-deck" aria-hidden="true">
    <div class="turntable-sticky">
      <div class="tt-plate" data-tt-plate>
        <div class="tt-vinyl" data-tt-vinyl>
          <span class="tt-label">LINER<br />FM</span>
          <span class="tt-spindle"></span>
        </div>
        <div class="tt-arm" data-tt-arm></div>
      </div>
    </div>
  </div>

  {/* In scena c'è solo il disco: due righe, una sopra e una sotto, e niente
      che gli passi davanti. Il titolo di sezione arriva dopo, quando il disco
      è già sceso sul fondo. */}
  {/* Una schermata piena in cui non c'è altro: il nome, cosa fa, il disco che
      gira e l'invito a scendere. Resta ferma per un tratto di scorrimento, poi
      si dissolve e lascia il posto al contenuto. */}
  <section class="tt-opening" data-tt-opening>
    <div class="tt-opening-copy" data-tt-copy>
      <div class="tt-opening-top">
        {/* Il nome del prodotto, non un titolo di sezione: come <h2> arrivava
            prima dell'<h1> della pagina, e chi naviga per intestazioni trovava
            un livello 2 orfano in cima al documento. */}
        <p class="tt-wordmark">Liner<span>FM</span></p>
        <p>
          The music companion for macOS: a living widget, a notch bar with
          controls, synced lyrics, a full screen screensaver, and a curator
          that learns your taste.
        </p>
      </div>
      <span class="tt-scroll">Scroll down</span>
    </div>
  </section>

  <slot />
</div>

<script>
  const block = document.querySelector<HTMLElement>("[data-turntable]");
  const plate = block?.querySelector<HTMLElement>("[data-tt-plate]");
  const vinyl = block?.querySelector<HTMLElement>("[data-tt-vinyl]");
  const arm = block?.querySelector<HTMLElement>("[data-tt-arm]");
  const label = block?.querySelector<HTMLElement>(".tt-label");
  const opening = block?.querySelector<HTMLElement>("[data-tt-opening]");
  const copy = block?.querySelector<HTMLElement>("[data-tt-copy]");
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (block && plate && vinyl && arm && opening && copy && !still) {
    // Le voci si accendono al passaggio. La classe la mette lo script: senza
    // JavaScript nessuna card parte attenuata.
    const items = block.querySelectorAll<HTMLElement>(".panel-quiet");
    if (items.length) {
      document.body.classList.add("js-reveal");
      items.forEach((el) => el.classList.add("reveal"));
      const seen = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            // Chi è già passato sopra la finestra (arrivo da un link con
            // ancora, ricarica a metà pagina) va acceso subito, o resterebbe
            // attenuato per sempre alle spalle di chi risale.
            if (!e.isIntersecting && e.boundingClientRect.top > 0) continue;
            e.target.classList.add("is-on");
            seen.unobserve(e.target);
          }
        },
        { rootMargin: "0px 0px -12% 0px", threshold: 0.15 },
      );
      items.forEach((el) => seen.observe(el));
    }

    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    // Curva morbida in entrata e in uscita, più dolce di una smoothstep: la
    // partenza è quasi impercettibile e l'arrivo non ha frenata.
    const ease = (t: number) =>
      t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    // Curva più piatta al centro: la cubica qui sopra tocca una velocità
    // massima tripla di quella media, e nel mezzo della discesa il disco
    // saltava di 361px in un colpo. Questa arriva a una volta e mezza.
    const soft = (t: number) => t * t * (3 - 2 * t);
    const mix = (a: number, b: number, t: number) => a + (b - a) * t;

    const draw = () => {
      queued = false;

      // Quanto dell'apertura è passato: 0 quando riempie la finestra, 1 quando
      // è tutta sopra. È l'unica cosa che governa il passaggio da protagonista
      // a sfondo.
      const o = opening.getBoundingClientRect();
      // p va da 0 (schermata appena arrivata) a 1 (apertura tutta passata).
      // La schermata è più alta della finestra apposta: nel primo tratto resta
      // ferma e succede una cosa sola, il disco gira. L'uscita comincia dopo.
      const span = Math.max(1, o.height - window.innerHeight);
      const p = clamp(-o.top / span);
      // Tre tempi. Prima il testo se ne va; poi c'è un tratto in cui il disco
      // sta al centro e l'unica cosa che succede è che gira; solo alla fine
      // scivola verso destra, e arriva a destinazione proprio quando
      // l'apertura è passata e da sotto sale l'hero.
      // La tenuta sta PRIMA che il testo se ne vada: per metà del tratto la
      // schermata resta quella di apertura e l'unica cosa che succede è che il
      // disco gira. Poi, in un tratto solo, il testo esce e il disco scende,
      // mentre da sotto sale l'hero. Mettere la tenuta dopo l'uscita del testo
      // lasciava trecento pixel di nero con il disco da solo.
      const tCopy = ease(clamp((p - 0.72) / 0.28));
      // metà del tratto per la discesa, così il movimento è lungo e graduale
      const t = soft(clamp((p - 0.48) / 0.52));

      // Il disco non rimpicciolisce: cresce e si sposta finché il suo centro
      // arriva sul bordo destro della finestra, cioè resta in vista la metà
      // sinistra. Le distanze sono in unità di finestra, così non serve
      // misurare niente a ogni fotogramma.
      plate.style.transform =
        `translate(${mix(0, 50, t)}vw, ${mix(0, 4, t)}vh) scale(${mix(1, 1.45, t)})`;
      plate.style.opacity = String(mix(1, 0.55, t));
      // il braccio se ne va prima del disco: sul fondo sarebbe solo rumore
      arm.style.opacity = String(clamp(1 - t * 2.2));
      // l'etichetta verde si attenua più del resto: i solchi sono neri e non
      // tolgono contrasto a niente, il verde sì
      if (label) label.style.opacity = String(mix(1, 0.5, t));
      copy.style.opacity = String(clamp(1 - tCopy));
      copy.style.transform = `translateY(${-tCopy * 70}px)`;

      // La rotazione segue i pixel scorsi dentro al blocco, non una fase: così
      // il disco gira già durante l'apertura e non si ferma mai fino in fondo.
      // Due velocità: in apertura, quando il disco è l'unica cosa in scena,
      // fa più di due giri interi mentre si scende; dopo rallenta, perché
      // sullo sfondo di una pagina di testo una trottola distrae.
      // pixel davvero scorsi dentro al blocco: partendo da mezzo schermo il
      // disco arrivava già ruotato di 669 gradi e la fase veloce era finita
      // prima ancora di cominciare
      const r = block.getBoundingClientRect();
      const scrolled = Math.max(0, -r.top);
      const APERTURA = 420;
      const deg = scrolled <= APERTURA
        ? scrolled * 1.9
        : APERTURA * 1.9 + (scrolled - APERTURA) * 0.3;
      vinyl.style.transform = `rotate(${deg}deg)`;
    };

    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(draw);
    };
    addEventListener("scroll", onScroll, { passive: true });
    addEventListener("resize", onScroll, { passive: true });
    draw();
  }
</script>
