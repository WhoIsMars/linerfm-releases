---
import DownloadButton from "./DownloadButton.tsx";
import { mediaSize } from "../lib/media-dimensions";

const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, "/");
const steps = [
  { t: "Open the .dmg and drag LinerFM to Applications.", file: "gatekeeper-1.png" },
  { t: "First launch shows a security warning. That's expected: the app isn't notarized yet.", file: "gatekeeper-2.png" },
  { t: "Go to System Settings → Privacy & Security → click \"Open Anyway\".", file: "gatekeeper-3.png" },
];
// I quattro passi in testa (22/10, sul modello del "Setup" di iBaila): l'avviso di sicurezza è
// il passo 2, spiegato prima del download, non una sorpresa dopo. Niente tempi promessi: la
// configurazione guidata chiede di incollare chiavi, e quanto ci vuole non è misurato.
const setup = [
  { t: "Download", d: "The .dmg for your Mac's chip, or the installer for Windows 10 and 11." },
  { t: "Open it once", d: "It isn't signed by Apple or Microsoft yet. On a Mac, click Open Anyway in Privacy & Security; on Windows, More info, then Run anyway." },
  // 23/10: widget e desktop seguono Spotify senza Client ID (dev app su profilo vuoto, visto
  // dall'owner). Gli account vengono dopo e sono facoltativi: prima diceva "paste every key".
  { t: "Press play", d: "Play a song in Spotify. The wallpaper, the widget and the lyrics follow it. No key, no account." },
  { t: "Connect, if you want", d: "Link Spotify, Apple Music or YouTube Music for playlists, search and the AI tools. The guided setup checks each key while you paste it." },
];
---
<section id="download" class="max-w-6xl mx-auto px-5 pt-28 md:pt-36 pb-20 text-center scroll-mt-16">
  <p class="eyebrow">Setup</p>
  <h2 class="display-2 mt-4 mx-auto max-w-[18ch]">Download &amp; install. <span class="display-dim">Four steps, no account.</span></h2>

  <ol class="mt-14 grid sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-10 text-left">
    {setup.map((st, i) => (
      <li class="border-t border-hairline pt-5">
        <span class="text-sm font-semibold tabular-nums text-fg-3">{String(i + 1).padStart(2, "0")}</span>
        <h3 class="mt-2 font-semibold text-lg">{st.t}</h3>
        <p class="mt-2 text-sm text-fg-3 leading-relaxed">{st.d}</p>
      </li>
    ))}
  </ol>

  <p class="mt-14 text-fg-3">Free 5-day trial. Native builds for macOS 11+ (choose your Mac's chip) and for Windows 10 and 11.</p>

  <p class="phone-only mt-4 text-sm text-fg-2">LinerFM runs on Mac and Windows. Open this page on your computer to install it.</p>

  <div class="mt-8 flex justify-center">
    <DownloadButton client:visible />
  </div>
  <p class="mt-3 text-xs text-fg-3">Not sure? Apple menu →  About This Mac. "Apple M1/M2/M3…" = Apple Silicon, "Intel" = Intel.</p>

  <div id="first-launch-mac" class="mt-12 max-w-4xl mx-auto panel p-6 md:p-8 text-left">
    <h3 class="font-semibold">First launch on macOS</h3>
    <p class="mt-1 text-sm text-fg-3">LinerFM isn't notarized yet (coming soon). On first open you'll need to allow it:</p>
    <ol class="mt-6 grid md:grid-cols-3 gap-5">
      {steps.map((s, i) => (
        <li class="rounded-control border border-hairline overflow-hidden">
          {/* alt vuoto per scelta: lo screenshot illustra il passo che sta scritto
              qui sotto, e ripeterlo farebbe leggere due volte la stessa frase. */}
          <img
            src={`${base}screenshots/${s.file}`}
            alt=""
            width={mediaSize(`screenshots/${s.file}`)?.width}
            height={mediaSize(`screenshots/${s.file}`)?.height}
            class="shot-tall block"
            loading="lazy"
          />
          <p class="p-3 text-xs text-fg-2"><span class="text-fg font-semibold tabular-nums">{i + 1}.</span> {s.t}</p>
        </li>
      ))}
    </ol>
    <div class="mt-6">
      <p class="text-sm text-fg-3">Prefer the terminal? Run:</p>
      <code class="mt-2 block bg-ink-950 border border-hairline rounded-lg px-4 py-3 text-sm text-mint-300 select-all overflow-x-auto">xattr -dr com.apple.quarantine /Applications/LinerFM.app</code>
    </div>
  </div>

  <div class="mt-6 max-w-4xl mx-auto panel p-6 md:p-8 text-left">
    <h3 class="font-semibold">First launch on Windows</h3>
    <p class="mt-1 text-sm text-fg-3">The installer isn't code signed yet, so Windows SmartScreen may say it protected your PC. Click "More info", then "Run anyway". It installs for your user only, no admin rights needed.</p>
    <p class="mt-3 text-sm text-fg-3">LinerFM for Windows 10 and 11: the widget, search, lyrics, a top bar in place of the notch, the screensaver, the volume HUD, the live desktop, AI and stats.</p>
  </div>
</section>
