---
import DownloadButton from "./DownloadButton.tsx";
import { mediaSize } from "../lib/media-dimensions";

const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, "/");
const steps = [
  { t: "Open the .dmg and drag LinerFM to Applications.", file: "gatekeeper-1.png" },
  { t: "First launch shows a security warning. That's expected: the app isn't notarized yet.", file: "gatekeeper-2.png" },
  { t: "Go to System Settings → Privacy & Security → click \"Open Anyway\".", file: "gatekeeper-3.png" },
];
---
<section id="download" class="max-w-4xl mx-auto px-5 py-20 text-center">
  <h2 class="text-3xl font-semibold tracking-[-0.02em]">Download & install</h2>
  <p class="mt-3 text-fg-3">Free 5-day trial. Native builds for macOS 11+, choose your Mac's chip.</p>

  <div class="mt-8 flex justify-center">
    <DownloadButton client:visible />
  </div>
  <p class="mt-3 text-xs text-fg-3">Not sure? Apple menu →  About This Mac. "Apple M1/M2/M3…" = Apple Silicon, "Intel" = Intel.</p>

  <div class="mt-12 panel p-6 md:p-8 text-left">
    <h3 class="font-semibold">First launch on macOS</h3>
    <p class="mt-1 text-sm text-fg-3">LinerFM isn't notarized yet (coming soon). On first open you'll need to allow it:</p>
    <ol class="mt-6 grid md:grid-cols-3 gap-5">
      {steps.map((s, i) => (
        <li class="rounded-control border border-hairline overflow-hidden">
          {/* alt vuoto per scelta: lo screenshot illustra il passo che sta scritto
              qui sotto, e ripeterlo farebbe leggere due volte la stessa frase. */}
          <img
            src={`${base}screenshots/${s.file}`}
            alt=""
            width={mediaSize(`screenshots/${s.file}`)?.width}
            height={mediaSize(`screenshots/${s.file}`)?.height}
            class="shot-tall block"
            loading="lazy"
          />
          <p class="p-3 text-xs text-fg-2"><span class="text-fg font-semibold tabular-nums">{i + 1}.</span> {s.t}</p>
        </li>
      ))}
    </ol>
    <div class="mt-6">
      <p class="text-sm text-fg-3">Prefer the terminal? Run:</p>
      <code class="mt-2 block bg-ink-950 border border-hairline rounded-lg px-4 py-3 text-sm text-mint-300 select-all overflow-x-auto">xattr -dr com.apple.quarantine /Applications/LinerFM.app</code>
    </div>
  </div>
</section>
