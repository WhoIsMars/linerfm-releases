---
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";
import DownloadButton from "./DownloadButton.tsx";
const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, "/");
const steps = [
  { t: "Open the .dmg and drag LinerFM to Applications.", file: "gatekeeper-1.png" },
  { t: "First launch shows a security warning — that's expected (not yet notarized).", file: "gatekeeper-2.png" },
  { t: "Go to System Settings → Privacy & Security → click \"Open Anyway\".", file: "gatekeeper-3.png" },
];
// Show real screenshots only once they exist; otherwise a clean numbered placeholder.
const shotsExist = steps.every((s) =>
  existsSync(fileURLToPath(new URL(`../../public/screenshots/${s.file}`, import.meta.url)))
);
---
<section id="download" class="max-w-4xl mx-auto px-5 py-20 text-center">
  <h2 class="text-3xl font-bold tracking-tight">Download & install</h2>
  <p class="mt-2 text-white/60">Free 5-day trial. Native builds for macOS 11+ — choose your Mac's chip.</p>

  <div class="mt-8 flex justify-center">
    <DownloadButton client:visible />
  </div>
  <p class="mt-3 text-xs text-white/40">Not sure? Apple menu →  About This Mac. "Apple M1/M2/M3…" = Apple Silicon, "Intel" = Intel.</p>

  <div class="mt-12 rounded-2xl border border-white/10 bg-white/[.02] p-6 md:p-8 text-left">
    <h3 class="font-semibold">First launch on macOS</h3>
    <p class="mt-1 text-sm text-white/60">LinerFM isn't notarized yet (coming soon). On first open you'll need to allow it:</p>
    <ol class="mt-6 grid md:grid-cols-3 gap-5">
      {steps.map((s, i) => (
        <li class="rounded-xl border border-white/10 overflow-hidden">
          {shotsExist ? (
            <img src={`${base}screenshots/${s.file}`} alt={`Step ${i + 1}`} class="block w-full h-auto" loading="lazy" />
          ) : (
            <div class="aspect-[4/3] grid place-items-center bg-ink-800 text-3xl font-bold text-mint-300/70">{i + 1}</div>
          )}
          <p class="p-3 text-xs text-white/70"><span class="text-mint-300 font-semibold">{i + 1}.</span> {s.t}</p>
        </li>
      ))}
    </ol>
    <div class="mt-6">
      <p class="text-sm text-white/60">Prefer the terminal? Run:</p>
      <code class="mt-2 block bg-ink-950 border border-white/10 rounded-lg px-4 py-3 text-sm text-mint-300 select-all">xattr -dr com.apple.quarantine /Applications/LinerFM.app</code>
    </div>
  </div>
</section>
