---
import MacWindow from "./MacWindow.astro";
import { mediaSize } from "../lib/media-dimensions";

const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, "/");
const steps = [
  { n: "1", t: "Connect", img: "connect.png", d: "Add your own Spotify key with a guided wizard, or connect YouTube Music with the session you already have in Chrome. No middleman." },
  { n: "2", t: "Curate with AI", img: "ai.png", d: "Describe a vibe and let the AI build or extend a playlist; every track is checked against your own source before you commit." },
  { n: "3", t: "Apply", img: "apply.png", d: "Push changes straight to your playlist, or copy the track links and paste them into your music app." },
];
---
<section id="how" class="max-w-6xl mx-auto px-5 py-20">
  <h2 class="text-3xl font-semibold tracking-[-0.02em] text-center">How it works</h2>
  <p class="mt-3 text-center text-fg-3">Three steps, all on your machine.</p>
  <!-- Qui i tre riquadri sono un set e devono finire alla stessa quota: ora che
       le finestre hanno tutte lo stesso rapporto, stirare non lascia più vuoti. -->
  <div class="mt-12 grid md:grid-cols-3 gap-6">
    {steps.map((s) => (
      <div class="panel-quiet p-6">
        {/* Qui il numero conta davvero, i tre passi sono una sequenza: resta,
            ma in materiale neutro, perché non è un'azione da fare. */}
        <div class="w-9 h-9 rounded-full bg-panel-2 border border-hairline text-fg-2 grid place-items-center text-sm font-semibold tabular-nums">{s.n}</div>
        <h3 class="mt-4 text-lg font-semibold">{s.t}</h3>
        <p class="mt-2 text-sm text-fg-3 leading-relaxed">{s.d}</p>
        <MacWindow class="mt-5" glow={false}>
          <img
            src={`${base}screenshots/${s.img}`}
            alt={`The ${s.t} screen in LinerFM`}
            width={mediaSize(`screenshots/${s.img}`)?.width}
            height={mediaSize(`screenshots/${s.img}`)?.height}
            class="shot-uniform block"
            loading="lazy"
          />
        </MacWindow>
      </div>
    ))}
  </div>
</section>
