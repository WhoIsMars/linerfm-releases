---
import { DISCORD_URL, X_URL, INSTAGRAM_URL, REPO_URL } from "../config/links";
const year = new Date().getFullYear();
const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, "/");
---
<footer class="border-t border-hairline mt-10">
  <div class="max-w-6xl mx-auto px-5 py-12 text-sm text-fg-3">
    <p class="max-w-2xl">LinerFM is not affiliated with, endorsed or sponsored by Spotify, Apple or Google. Spotify is a trademark of Spotify AB, Apple Music of Apple Inc., YouTube Music of Google LLC.</p>
    <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
      <a href={`${base}privacy`} class="hover:text-fg">Privacy</a>
      <a href={`${base}eula`} class="hover:text-fg">License (EULA)</a>
      <a href={DISCORD_URL} class="hover:text-fg">Discord</a>
      <a href={X_URL} class="hover:text-fg">X</a>
      <a href={INSTAGRAM_URL} class="hover:text-fg">Instagram</a>
      <a href={REPO_URL} class="hover:text-fg">GitHub</a>
      <a href={`${base}changelog`} class="hover:text-fg">What's new</a>
    </div>
    <p class="mt-6 text-fg-3">© {year} LinerFM</p>
  </div>
</footer>
