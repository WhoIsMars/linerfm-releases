---
import { DISCORD_URL, X_URL, REPO_URL } from "../config/links";
const year = new Date().getFullYear();
const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, "/");
---
<footer class="border-t border-white/10 mt-10">
  <div class="max-w-6xl mx-auto px-5 py-12 text-sm text-white/50">
    <p class="max-w-2xl">LinerFM is not affiliated with, endorsed or sponsored by Spotify. Spotify is a trademark of Spotify AB.</p>
    <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
      <a href={`${base}privacy`} class="hover:text-white">Privacy</a>
      <a href={`${base}eula`} class="hover:text-white">License (EULA)</a>
      <a href={DISCORD_URL} class="hover:text-white">Discord</a>
      <a href={X_URL} class="hover:text-white">X</a>
      <a href={REPO_URL} class="hover:text-white">GitHub</a>
      <a href={`${base}changelog`} class="hover:text-white">What's new</a>
    </div>
    <p class="mt-6 text-white/30">© {year} LinerFM</p>
  </div>
</footer>
