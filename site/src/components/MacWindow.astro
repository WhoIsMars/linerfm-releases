---
const { label = "", glow = true, class: klass = "" } = Astro.props;
---
<div class={`relative rounded-xl border border-hairline bg-gradient-to-br from-ink-800 to-ink-900 shadow-[0_28px_70px_rgba(0,0,0,.6),inset_0_1px_0_rgba(255,255,255,.07)] overflow-hidden ${klass}`}>
  <div class="flex items-center gap-2 px-3.5 py-2.5 border-b border-hairline">
    <span class="w-3 h-3 rounded-full bg-[#ff5f57]"></span>
    <span class="w-3 h-3 rounded-full bg-[#febc2e]"></span>
    <span class="w-3 h-3 rounded-full bg-[#28c840]"></span>
    {label && <span class="ml-2 text-xs text-fg-3">{label}</span>}
  </div>
  <div class="relative">
    <slot />
    {/* il velo sotto la finestra era verde: ora è solo un'ombra, e la finestra
        smette di sembrare illuminata da qualcosa che non c'è */}
    {glow && <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black/40 to-transparent"></div>}
  </div>
</div>
