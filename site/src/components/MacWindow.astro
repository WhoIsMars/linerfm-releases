---
const { label = "", glow = true, class: klass = "" } = Astro.props;
---
<div class={`relative rounded-xl border border-white/10 bg-gradient-to-br from-ink-800 to-ink-900 shadow-[0_28px_70px_rgba(0,0,0,.6)] overflow-hidden ${klass}`}>
  <div class="flex items-center gap-2 px-3.5 py-2.5 border-b border-white/5">
    <span class="w-3 h-3 rounded-full bg-[#ff5f57]"></span>
    <span class="w-3 h-3 rounded-full bg-[#febc2e]"></span>
    <span class="w-3 h-3 rounded-full bg-[#28c840]"></span>
    {label && <span class="ml-2 text-xs text-white/40">{label}</span>}
  </div>
  <div class="relative">
    <slot />
    {glow && <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/2 bg-[radial-gradient(60%_100%_at_50%_100%,rgba(29,185,84,.16),transparent)]"></div>}
  </div>
</div>
