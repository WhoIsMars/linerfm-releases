---
// Chiusura della pagina: chi è arrivato in fondo ha già letto tutto, gli serve solo il
// pulsante. Stessa azione dell'hero; titolo a scala di copertina come le sezioni (22/10).
import { CHECKOUT_URL } from "../config/links";
const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, "/");
---
<section class="max-w-6xl mx-auto px-5 pt-16 pb-28 text-center">
  <img src={`${base}icon-512.png`} alt="" width="96" height="96" class="mx-auto w-20 h-20 md:w-24 md:h-24" loading="lazy" />
  <h2 class="display mt-8 mx-auto max-w-[13ch]">Press play. <span class="display-dim">Watch your desktop follow.</span></h2>
  <div class="mt-10 flex flex-col items-center gap-3">
    <a href="#download" class="btn-primary font-semibold text-base px-7 py-3.5 rounded-full">Try free for 5 days</a>
    <p class="text-sm text-fg-3">Then 10€ once. <a href={CHECKOUT_URL} class="lemonsqueezy-button text-fg-2 underline underline-offset-4 hover:text-fg">Buy · 10€</a></p>
  </div>
</section>
