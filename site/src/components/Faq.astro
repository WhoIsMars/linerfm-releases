---
const faqs = [
  { q: "Do I need Spotify Premium?", a: "For the full live-apply experience with your own Spotify key, yes. You can also use the data-import and copy-to-clipboard modes without it." },
  { q: "Is this safe and legal?", a: "LinerFM runs entirely on your Mac and uses your own Spotify and Groq keys. It is not affiliated with Spotify and stores nothing on any server." },
  { q: "Why does macOS show a security warning?", a: "The app isn't notarized by Apple yet (it's a solo project). It's signed ad-hoc; see the install steps above. Notarization is planned." },
  { q: "Is there a free version?", a: "There's a full-featured 5-day free trial — no card needed. After it ends, a license is required to keep using LinerFM. There's no limited free tier, and reinstalling doesn't reset the trial." },
  { q: "Refunds?", a: "There's a free trial, so purchases are final — except genuine edge cases (double purchase, app won't start on your Mac), handled case by case." },
  { q: "Where does my data go?", a: "Nowhere. No account, no telemetry. Your listening data and keys stay on your Mac." },
  { q: "Which Macs are supported?", a: "LinerFM ships as a universal app that runs natively on both Intel and Apple Silicon Macs, on macOS 11 or later. A Windows version may come later." },
];
---
<section id="faq" class="max-w-3xl mx-auto px-5 py-20">
  <h2 class="text-3xl font-bold tracking-tight text-center">FAQ</h2>
  <div class="mt-10 divide-y divide-white/10 border-y border-white/10">
    {faqs.map((f) => (
      <details class="group py-4">
        <summary class="flex items-center justify-between cursor-pointer list-none font-medium">
          {f.q}
          <span class="text-white/40 group-open:rotate-45 transition-transform text-xl leading-none">+</span>
        </summary>
        <p class="mt-3 text-sm text-white/60 leading-relaxed">{f.a}</p>
      </details>
    ))}
  </div>
</section>
