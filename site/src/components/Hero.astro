---
import { CHECKOUT_URL } from "../config/links";
const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, "/");
---
<section id="top" class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(900px_360px_at_78%_-12%,rgba(29,185,84,.28),transparent_60%),radial-gradient(600px_300px_at_8%_110%,rgba(20,145,68,.18),transparent_60%)]"></div>
  <div class="relative max-w-6xl mx-auto grid md:grid-cols-[1.1fr_.9fr] gap-9 items-center px-5 py-20">
    <div>
      <span class="inline-flex items-center gap-2 text-xs px-3 py-1.5 rounded-full bg-green-500/10 border border-green-500/30 text-mint-300">
        <span class="w-1.5 h-1.5 rounded-full bg-green-500 shadow-[0_0_10px_#1DB954]"></span>
        Now playing · live on your desktop
      </span>
      <h1 class="mt-4 text-4xl md:text-5xl font-bold leading-[1.08] tracking-tight text-gradient">
        Your desktop, finally curating itself.
      </h1>
      <p class="mt-4 text-white/70 text-base md:text-lg max-w-xl leading-relaxed">
        The music companion for macOS, on Spotify, Apple Music or YouTube Music:
        a living desktop widget, a notch bar with controls and seek, synced lyrics,
        a music screensaver, and a curator that learns your taste. All running
        locally on your Mac.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href={CHECKOUT_URL} class="lemonsqueezy-button btn-primary font-semibold px-6 py-3 rounded-xl">Buy · 10€</a>
        <a href="#download" class="btn-ghost font-semibold px-6 py-3 rounded-xl">Try free · 5 days</a>
      </div>
      <p class="mt-4 text-xs text-white/40 tracking-wide">macOS (Intel &amp; Apple Silicon) · 100% local · no account · no telemetry</p>
    </div>
    <div class="relative flex justify-center">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(50%_50%_at_50%_50%,rgba(29,185,84,.20),transparent_70%)] blur-2xl"></div>
      <video
        src={`${base}video/hero-clip.mp4`}
        poster={`${base}screenshots/widget.png`}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-label="LinerFM in action: AI playlists, a full-screen music screensaver, and the now-playing widget with animated canvas and synced lyrics"
        class="relative w-full max-w-[520px] h-auto rounded-xl border border-white/10 drop-shadow-[0_30px_60px_rgba(0,0,0,.55)]"
      ></video>
    </div>
  </div>
</section>
