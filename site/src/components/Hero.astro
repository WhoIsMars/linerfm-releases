---
// Il primo schermo (24/10/2026, sul modello di iBaila): la promessa, una riga, il pulsante che
// scarica la build di questo computer, la riga "No account. 5 days free. 10€ once." e i profili;
// accanto, la ripresa vera del desktop che diventa la canzone (telefono dell'owner, ph8700).
// La prova gratuita e' il vantaggio che iBaila non ha: si dice qui e una volta a meta' pagina.
import { CHECKOUT_URL, SOCIAL_LINKS } from "../config/links";
import AmbientVideo from "./AmbientVideo.astro";
import DownloadButton from "./DownloadButton.tsx";

const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, "/");
---
<section id="top" class="screen" aria-labelledby="hero-title">
  <div class="max-w-6xl w-full mx-auto px-4 sm:px-6 grid lg:grid-cols-[1.1fr_1fr] gap-12 lg:gap-16 items-center">
    <div class="text-center lg:text-left">
      <h1 id="hero-title" class="t-hero mx-auto lg:mx-0 max-w-[13ch]">Your desktop plays the song you're on.</h1>
      <p class="t-lead mt-6 mx-auto lg:mx-0 max-w-[40ch]">
        The artwork, the Spotify Canvas or the YouTube video becomes your wallpaper, with a light around the screen.
      </p>
      {/* Solo su telefono: l'app non si installa li', il pulsante porta ai download. */}
      <p class="phone-only mt-4 mx-auto max-w-sm text-fg-2 text-sm leading-snug text-pretty">
        LinerFM runs on Mac and Windows. Open this page on your computer to install it.
      </p>
      <div class="mt-8 flex flex-col items-center lg:items-start gap-3">
        <div class="desktop-only hero-dl"><DownloadButton compact client:load /></div>
        <a href="#download" class="phone-only btn-primary font-semibold text-base px-7 py-3.5 rounded-full">Try free for 5 days</a>
        <p class="text-[0.9375rem] font-medium text-fg">No account. 5 days free. 10€ once.</p>
        <p class="text-sm text-fg-3">
          Sure already? <a href={CHECKOUT_URL} class="lemonsqueezy-button text-fg-2 underline underline-offset-4 hover:text-fg">Buy · 10€</a>
        </p>
      </div>
      <p class="mt-8 text-xs text-fg-3">Spotify, Apple Music, YouTube Music and SoundCloud · Mac and Windows</p>
      {/* I profili: chi arriva da un reel cerca la community e il resto dei video (23/10). */}
      <p class="mt-2 text-xs text-fg-3 flex flex-wrap justify-center lg:justify-start gap-x-4 gap-y-1">
        {SOCIAL_LINKS.map((s) => <a href={s.href} class="underline underline-offset-4 hover:text-fg" rel="me">{s.name}</a>)}
      </p>
    </div>

    <figure class="take lit m-0" style={`--art:url(${base}media/hero.jpg)`}>
      <AmbientVideo
        src="media/hero.mp4"
        poster="media/hero.jpg"
        description="Filmed with a phone: a MacBook and a monitor playing HIGHEST IN THE ROOM by Travis Scott. The Spotify Canvas plays as the wallpaper of both screens, the albums slide under the clock, and a blue light runs around the laptop screen."
      />
      <figcaption class="take-caption">Real footage on a Mac. The live wallpaper runs on Windows too.</figcaption>
    </figure>
  </div>
</section>
