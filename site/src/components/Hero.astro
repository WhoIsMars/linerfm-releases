---
// Il prodotto si presenta da solo: titolo, due pulsanti e subito sotto la
// presentazione orizzontale (48 s, resa dalla UI vera con brani e copertine
// inventati). È il "See it in action" di prima, portato in cima: chi arriva
// vede LinerFM funzionare prima di leggere un elenco.
import { CHECKOUT_URL } from "../config/links";
import { mediaSize } from "../lib/media-dimensions";

const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, "/");
const video = mediaSize("video/explainer.mp4");
---
<section id="top" class="relative">
  <div class="max-w-6xl mx-auto px-5 pt-14 md:pt-20 text-center">
    <span class="inline-flex items-center gap-2 text-xs px-3 py-1.5 rounded-full bg-panel border border-hairline text-fg-2">
      <span class="status-dot"></span>
      For Spotify, Apple Music and YouTube Music
    </span>
    <h1 class="mt-5 mx-auto text-[2.6rem] md:text-[3.6rem] font-semibold leading-[1.04] tracking-[-0.03em] text-balance max-w-[18ch]">
      Your desktop, finally curating itself.
    </h1>
    <p class="mt-5 mx-auto text-fg-2 text-base md:text-lg max-w-2xl leading-relaxed text-pretty">
      LinerFM puts your music all over your Mac: a player in the notch, live lyrics,
      a widget that matches every album, a screensaver, and AI playlists made of real tracks.
      Everything runs on your Mac.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="#download" class="btn-primary font-semibold px-6 py-3 rounded-control">Try free for 5 days</a>
      <a href={CHECKOUT_URL} class="lemonsqueezy-button btn-ghost font-semibold px-6 py-3 rounded-control">Buy · 10€</a>
    </div>
    <p class="mt-5 text-xs text-fg-3 tracking-wide">No card for the trial · Apple Silicon &amp; Intel · No account · No telemetry</p>
  </div>

  <div class="max-w-5xl mx-auto px-5 mt-12 md:mt-14">
    {/* Controlli nativi: coprono la pausa di WCAG 2.2.2 e lasciano accendere
        l'audio a chi vuole sentire la musica del video. */}
    <figure class="panel p-2 md:p-2.5 m-0">
      <video
        src={`${base}video/explainer.mp4`}
        poster={`${base}video/explainer.jpg`}
        width={video?.width}
        height={video?.height}
        autoplay
        muted
        loop
        playsinline
        controls
        preload="metadata"
        class="block w-full h-auto rounded-[10px] bg-ink-900"
      ></video>
      <figcaption class="sr-only">
        A 48-second tour of LinerFM: the notch player and live lyrics, the desktop widget that
        re-colors itself from the artwork, the terminal look, the screensaver, Command Shift K
        search, AI playlists, skip-based cleanup and play counts.
      </figcaption>
    </figure>
  </div>
</section>

<script>
  // Con "Riduci movimento" il video resta sul poster finché non lo si avvia.
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const v = document.querySelector<HTMLVideoElement>("#top video");
    if (v) { v.autoplay = false; v.pause(); }
  }
</script>
