---
// Le card vengono da src/data/features.json, generato da docs/product-surface.json
// nel repo dell'app (`node scripts/sync-product-surface.mjs`): una feature nuova
// si aggiunge là e compare qui senza toccare questo componente.
//
// Le feature già raccontate in Showcase non si ripetono: qui c'è "tutto il resto".
import data from "../data/features.json";

// Il badge "New" segue la versione piu' alta fra le card, non un numero scritto
// a mano: scritto a mano resta indietro al primo rilascio che non aggiunge
// feature, e la 0.9.1 e' stata esattamente quel caso.
const rank = (v: string) => v.split(".").map(Number).reduce((a, n) => a * 1000 + n, 0);
const CURRENT = data.cards.map((f) => f.since).sort((a, b) => rank(a) - rank(b)).at(-1);

const IN_SHOWCASE = new Set([
  "widget", "notch-hover", "dynamic-color", "search", "karaoke", "screensaver",
  "ai-playlists", "terminal-theme", "track-stats", "skip-based-removals",
]);
// Una griglia sola, le novità dell'ultima versione in testa. I gruppi per tema
// lasciavano righe a metà (4, 5, 4 e 7 card su tre colonne); 20 card su quattro
// colonne chiudono righe piene, e una feature nuova entra senza toccare niente.
const cards = [
  ...data.cards.filter((c) => !IN_SHOWCASE.has(c.id) && c.since === CURRENT),
  ...data.cards.filter((c) => !IN_SHOWCASE.has(c.id) && c.since !== CURRENT),
];
---
<section id="features" class="max-w-6xl mx-auto px-5 py-24">
  <h2 class="text-3xl font-semibold tracking-[-0.02em] text-center">And everything around it</h2>
  <p class="mt-3 text-center text-fg-3">The details that make it feel like it belongs on a Mac.</p>

  <div class="mt-14 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {cards.map((f) => (
      <div class="panel-quiet p-5">
        {f.since === CURRENT && (
          <span class="mb-3 w-fit flex items-center gap-1.5 text-[10px] uppercase tracking-wider font-semibold text-mint-300 border border-hairline bg-panel-2 rounded-full px-2 py-0.5">
            <span class="status-dot"></span>New
          </span>
        )}
        <h3 class="font-semibold">{f.t}</h3>
        <p class="mt-1.5 text-sm text-fg-3 leading-relaxed">{f.d}</p>
      </div>
    ))}
  </div>
</section>
