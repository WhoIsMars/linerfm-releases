---
// Le card vengono da src/data/features.json, generato da docs/product-surface.json
// nel repo dell'app (`node scripts/sync-product-surface.mjs`): una feature nuova
// si aggiunge là e compare qui senza toccare questo componente.
import data from "../data/features.json";

const features = data.cards;
// Il badge "New" segue la versione piu' alta fra le card, non un numero scritto
// a mano: scritto a mano resta indietro al primo rilascio che non aggiunge
// feature, e la 0.9.1 e' stata esattamente quel caso.
const rank = (v) => v.split(".").map(Number).reduce((a, n) => a * 1000 + n, 0);
const CURRENT = features.map((f) => f.since).sort((a, b) => rank(a) - rank(b)).at(-1);
---
<section id="features" class="max-w-6xl mx-auto px-5 py-20">
  <h2 class="text-3xl font-semibold tracking-[-0.02em] text-center">What makes LinerFM different</h2>
  <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {features.map((f) => (
      <div class="panel-quiet p-6">
        {/* Il pallino verde stava su ogni card allo stesso modo, quindi non
            distingueva niente. Il verde resta solo dove c'è una notizia vera,
            cioè sulle feature arrivate con l'ultima versione; le altre non
            hanno bisogno di dire da quanto ci sono. */}
        {f.since === CURRENT && (
          <span class="inline-flex items-center gap-1.5 text-[10px] uppercase tracking-wider font-semibold text-mint-300 border border-hairline bg-panel-2 rounded-full px-2 py-0.5">
            <span class="status-dot"></span>New
          </span>
        )}
        <h3 class:list={["font-semibold", f.since === CURRENT ? "mt-4" : "mt-0"]}>{f.t}</h3>
        <p class="mt-2 text-sm text-fg-3 leading-relaxed">{f.d}</p>
      </div>
    ))}
  </div>
</section>
