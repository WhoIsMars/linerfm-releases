---
const features = [
  { t: "Desktop widget", d: "A transparent, always-on now-playing widget with looping track canvases." },
  { t: "Notch bar", d: "Hover the notch for transport, a draggable seek bar and quick actions — three themes." },
  { t: "Live lyrics", d: "Synced karaoke line in a strip below the notch, four typographic styles." },
  { t: "Music screensaver", d: "Full-screen artwork and controls on ⇧⌘S or when idle; exits on any input." },
  { t: "Volume HUD", d: "A custom volume overlay themed after the album art, replacing the macOS one." },
  { t: "Discord presence", d: "Show what you're listening to on your Discord profile — one toggle, on by default." },
  { t: "AI playlist tools", d: "Create or extend playlists from a prompt, powered by your own free Groq key." },
  { t: "Smart curator", d: "A local ML curator learns what you skip and keeps your playlists in shape." },
  { t: "100% local", d: "No account, no telemetry, no server. Your listening data never leaves your Mac." },
];
---
<section id="features" class="max-w-6xl mx-auto px-5 py-20">
  <h2 class="text-3xl font-bold tracking-tight text-center">What makes LinerFM different</h2>
  <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {features.map((f) => (
      <div class="rounded-2xl border border-white/10 bg-white/[.02] p-6 hover:border-green-500/30 transition-colors">
        <div class="w-2.5 h-2.5 rounded-full bg-green-500 shadow-[0_0_12px_#1DB954]"></div>
        <h3 class="mt-4 font-semibold">{f.t}</h3>
        <p class="mt-2 text-sm text-white/60 leading-relaxed">{f.d}</p>
      </div>
    ))}
  </div>
</section>
