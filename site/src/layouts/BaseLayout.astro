---
import "../styles/global.css";
import ConsentBanner from "../components/ConsentBanner.astro";
const {
  title = "LinerFM: Spotify widget and live lyrics for Mac and Windows",
  description = "A notch player, live lyrics, a desktop widget that matches every album, a screensaver and AI playlists for Spotify, Apple Music and YouTube Music. Runs on Mac and Windows, no account. Try it free for 5 days.",
  ogImage = "/og.jpg",
} = Astro.props;
// Normalize base so it always ends with "/"
const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, "/");
const canonical = new URL(Astro.url.pathname, Astro.site ?? "http://localhost").href;
// Structured data so a search for "LinerFM" can show it as an app, with system and price.
const appLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "LinerFM",
  operatingSystem: "macOS, Windows",
  applicationCategory: "MultimediaApplication",
  description,
  url: new URL(base, Astro.site ?? "http://localhost").href,
  offers: { "@type": "Offer", price: "10.00", priceCurrency: "EUR" },
});
const og = new URL(`${base}${ogImage.replace(/^\//, "")}`, Astro.site ?? "http://localhost").href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <script type="application/ld+json" set:html={appLd} />
    <script src="https://assets.lemonsqueezy.com/lemon.js" defer is:inline></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
    <script>
      import { track } from "../lib/stats";
      track("view");
    </script>
    <ConsentBanner />
  </body>
</html>
